{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": ["core", "tags", "components", "context", "scripts", "api.ts", "standalone.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "vendor",
    "context/NextNavigationBridge.tsx"
  ]
}
